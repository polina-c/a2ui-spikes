{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "a2ui4w minimal AI site",
		"description": "A WordPress site whose front page is an AI Engine chat, booted from nothing every time.",
		"author": "a2ui4w"
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"siteOptions": {
		"blogname": "a2ui4w minimal",
		"blogdescription": "WordPress in WebAssembly, chatting through AI Engine"
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "ai-engine"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "bundled",
				"path": "a2ui-minimal-chat.php"
			},
			"options": {
				"activate": true
			}
		}
	]
}
