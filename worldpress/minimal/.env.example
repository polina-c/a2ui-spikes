# Copy to .env and fill in. .env is gitignored; nothing here reaches the database.

# --- Hosted provider (simplest) -------------------------------------------
# openai | anthropic | google | openrouter | mistral | perplexity | xai | custom
A2UI_AI_TYPE=openai
A2UI_AI_API_KEY=sk-your-key-here
# Optional. Leave unset to use AI Engine's own default model.
# A2UI_AI_MODEL=gpt-5-mini

# --- Local model instead, via any OpenAI-compatible server ----------------
# No cloud account and no key. Point at Ollama, LM Studio, llama.cpp, vLLM...
# Set the model explicitly here: AI Engine cannot guess what your server serves.
# A2UI_AI_TYPE=custom
# A2UI_AI_ENDPOINT=http://127.0.0.1:11434/v1
# A2UI_AI_MODEL=llama3.2
